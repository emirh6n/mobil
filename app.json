{
  "name": "TRKN Mobil",
  "displayName": "TRKN Mobil",
  "expo": {
    "name": "TRKN Mobil",
    "slug": "trkn-mobil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/new_icon.png",
    "android": {
      "package": "com.trkn.mobil",
      "icon": "./assets/new_icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/new_icon.png",
        "backgroundColor": "#121316"
      },
      "permissions": [
        "ACTIVITY_RECOGNITION"
      ]
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-font",

      [
        "expo-splash-screen",
        {
          "image": "./assets/new_splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#121316"
        }
      ],
      "expo-audio",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "b19047a5-b937-4d41-8707-8611c92830a4"
      }
    }
  }
}
