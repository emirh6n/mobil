        "foregroundImage": "./assets/logo.jpg",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "ACTIVITY_RECOGNITION"
      ]
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "b19047a5-b937-4d41-8707-8611c92830a4"
      }
    }
  }
}
