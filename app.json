{
  "name": "TRKN Mobil",
  "displayName": "TRKN Mobil",
  "expo": {
    "name": "TRKN Mobil",
    "slug": "trkn-mobil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "android": {
      "package": "com.trkn.mobil",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "ACTIVITY_RECOGNITION"
      ]
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b19047a5-b937-4d41-8707-8611c92830a4"
      }
    }
  }
}
