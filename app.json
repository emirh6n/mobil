{
  "name": "TRKN Mobil",
  "displayName": "TRKN Mobil",
  "expo": {
    "name": "TRKN Mobil",
    "slug": "trkn-mobil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.jpg",
    "splash": {
      "image": "./assets/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "android": {
      "package": "com.trkn.mobil",
