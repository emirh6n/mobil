{
  "name": "TRKN Mobil",
  "displayName": "TRKN Mobil",
  "expo": {
    "name": "TRKN Mobil",
    "slug": "trkn-mobil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/new_icon.png",
    "android": {
      "package": "com.trkn.mobil",
      "icon": "./assets/new_icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/new_icon.png",
        "backgroundColor": "#121316"
      },
      "permissions": [
        "ACTIVITY_RECOGNITION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "backgroundColor": "#121316",
      "image": "./assets/transparent.png",
      "resizeMode": "contain"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-font",
      "expo-splash-screen",
      "expo-audio",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "bfd89145-6af4-4066-9f29-9d26ebcb724f"
      }
    }
  }
}
